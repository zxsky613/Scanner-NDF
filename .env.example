EXPO_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Liens de confirmation e-mail (Apple 2.1) : dans Supabase Dashboard → Authentication → URL Configuration,
# autoriser Redirect URLs pour votre schéma (app.json expo.scheme), ex. dabars://** et l’URL exacte
# renvoyée par expo-linking createURL('login') sur une build iOS release (souvent dabars:///login).
# iOS / Android : appel direct à Groq
EXPO_PUBLIC_GROQ_API_KEY=
# Web (npm run dev --web) : déployer aussi la fonction extract-receipt et :
#   supabase secrets set GROQ_API_KEY=gsk_...   (même valeur possible que ci-dessus)

