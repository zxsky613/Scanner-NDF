{
  "expo": {
    "name": "DABAR's",
    "slug": "dabars",
    "scheme": "dabars",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-helicopter.png",
      "resizeMode": "contain",
      "backgroundColor": "#F2F6F8"
    },
    "ios": {
      "bundleIdentifier": "com.dabartechnique",
      "buildNumber": "23",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "L'application a besoin d'accéder à votre caméra pour scanner les tickets de caisse.",
        "NSPhotoLibraryUsageDescription": "L'application a besoin d'accéder à vos photos pour importer des justificatifs.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.dabartechnique",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F2F6F8"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow DABAR's to access your camera to scan receipts."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow DABAR's to access your photos to upload receipts."
        }
      ],
      "expo-localization",
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "0490563d-6da0-4616-8bd6-5f3263077bf4"
      }
    }
  }
}
